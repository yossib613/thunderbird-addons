{
  "manifest_version": 2,
  "name": "To & Cc Column",
  "version": "1.2.0",
  "description": "Adds a 'To & Cc' column to the message list.",
  "author": "Solutionist Ltd",
  "homepage_url": "https://github.com/yossib613/thunderbird-to-cc-column",
  "icons": {
    "64": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "to-cc-column@solutionist-ltd.com",
      "strict_min_version": "153.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "experiment_apis": {
    "toCcColumn": {
      "schema": "experiment/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["toCcColumn"]],
        "script": "experiment/implementation.js"
      }
    }
  }
}
